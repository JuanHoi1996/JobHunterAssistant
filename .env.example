# Never commit a real key. Hosted values belong in Sites private environment variables.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_JOB_MODEL=deepseek-v4-flash
DEEPSEEK_RESUME_MODEL=deepseek-v4-pro
# Optional: faster local UX testing (trade quality for latency)
# DEEPSEEK_RESUME_MODEL=deepseek-v4-flash

# Per upstream call (resume analysis runs two calls). Default 120000 if unset.
AI_REQUEST_TIMEOUT_MS=120000

# Only required when AI_PROVIDER=openai is explicitly selected.
OPENAI_API_KEY=
OPENAI_JOB_EXTRACTION_MODEL=gpt-5.6-terra
OPENAI_RESUME_MODEL=gpt-5.6-terra

# The existing ChatGPT sign-in allowlist remains an app access control, not an API key.
JOB_AI_ALLOWED_EMAILS=
